{#- 郵件用 HTML：多數郵件軟體不支援 <style> 與 CSS 變數，所以樣式一律 inline。
    台股慣例：紅漲綠跌。 -#}
{%- macro signed(v, fmt="{:,.2f}") -%}
  {%- if v is none -%}<span style="color:#888">—</span>
  {%- else -%}<span style="color:{{ '#d6343f' if v > 0 else ('#1a9e55' if v < 0 else '#555') }};font-weight:600">{{ '+' if v > 0 else '' }}{{ fmt.format(v) }}</span>
  {%- endif -%}
{%- endmacro -%}
{%- set th = "text-align:left;padding:8px 10px;background:#f4f5f7;color:#555;font-weight:600;font-size:13px;border-bottom:1px solid #e3e5e8" -%}
{%- set td = "padding:8px 10px;border-bottom:1px solid #eef0f2;font-size:14px" -%}
{%- set tdr = td ~ ";text-align:right;font-variant-numeric:tabular-nums" -%}
{%- set h2 = "font-size:16px;margin:28px 0 10px;color:#1c1e21;border-left:4px solid #3b5bdb;padding-left:10px" -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>台股盤後日報 {{ r.trade_date }}</title></head>
<body style="margin:0;padding:0;background:#f0f2f5;font-family:-apple-system,'Segoe UI','Noto Sans TC','Microsoft JhengHei',sans-serif;color:#1c1e21">
<div style="max-width:640px;margin:0 auto;padding:16px">
<div style="background:#fff;border-radius:10px;padding:24px 20px">

  <div style="font-size:13px;color:#777">{{ r.trade_date.strftime('%Y/%m/%d') }}（{{ weekday }}）</div>
  <h1 style="font-size:22px;margin:4px 0 16px">台股盤後日報</h1>

  <table role="presentation" style="width:100%;border-collapse:collapse"><tr>
    <td style="padding:14px;background:#f7f8fa;border-radius:8px;width:50%;vertical-align:top">
      <div style="font-size:13px;color:#777">加權指數</div>
      <div style="font-size:26px;font-weight:700;margin:4px 0">{{ "{:,.2f}".format(r.market.close) }}</div>
      <div>{{ signed(r.market.change) }}（{{ signed(r.market.change_pct) }}%）</div>
    </td>
    <td style="width:12px"></td>
    <td style="padding:14px;background:#f7f8fa;border-radius:8px;width:50%;vertical-align:top">
      <div style="font-size:13px;color:#777">成交金額</div>
      <div style="font-size:26px;font-weight:700;margin:4px 0">{{ "{:,.0f}".format(r.market.turnover_billion) }} <span style="font-size:14px;font-weight:400">億</span></div>
      <div style="font-size:14px">較前日 {{ signed(r.market.turnover_change_pct, "{:.1f}") }}%</div>
    </td>
  </tr></table>

  {% if r.ai_summary %}
  <h2 style="{{ h2 }}">AI 盤勢摘要</h2>
  <p style="font-size:15px;line-height:1.75;margin:0;background:#f5f7ff;padding:14px;border-radius:8px">{{ r.ai_summary }}</p>
  <div style="font-size:12px;color:#999;margin-top:6px">由 Claude 根據上方數據自動產生，僅供參考，不構成投資建議。</div>
  {% endif %}

  {% if chart_src %}
  <h2 style="{{ h2 }}">近 {{ r.trend|length }} 日趨勢</h2>
  <img src="{{ chart_src }}" width="600" alt="近 {{ r.trend|length }} 日加權指數、成交金額、外資籌碼與新台幣匯率趨勢圖" style="display:block;width:100%;max-width:600px;height:auto;border:0">
  {% endif %}

  {% if r.institutional %}
  <h2 style="{{ h2 }}">三大法人現貨買賣超</h2>
  <table style="width:100%;border-collapse:collapse">
    <tr><th style="{{ th }}">法人</th><th style="{{ th }};text-align:right">買賣超（億元）</th></tr>
    {% for f in r.institutional %}
    <tr {% if f.name == '合計' %}style="background:#fafafa"{% endif %}><td style="{{ td }}{% if f.name == '合計' %};font-weight:600{% endif %}">{{ f.name }}</td><td style="{{ tdr }}">{{ signed(f.net_billion) }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if r.futures %}
  <h2 style="{{ h2 }}">台指期三大法人未平倉</h2>
  <table style="width:100%;border-collapse:collapse">
    <tr><th style="{{ th }}">法人</th><th style="{{ th }};text-align:right">多空淨額（口）</th><th style="{{ th }};text-align:right">較前日</th></tr>
    {% for p in r.futures %}
    <tr><td style="{{ td }}">{{ p.name }}</td><td style="{{ tdr }}">{{ signed(p.net_oi, "{:,}") }}</td><td style="{{ tdr }}">{{ signed(p.net_oi_change, "{:,}") }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if r.fx or r.pcr or r.margin %}
  <h2 style="{{ h2 }}">匯率、選擇權與信用交易</h2>
  <table style="width:100%;border-collapse:collapse">
    {% if r.fx %}
    {#- 匯率數字變大是台幣貶值；不用紅綠色，避免與股價漲跌的直覺混淆 -#}
    <tr><td style="{{ td }}">新台幣兌美元<span style="color:#888;font-size:12px">（臺銀即期）</span></td><td style="{{ tdr }}">{{ "{:.3f}".format(r.fx.usd_twd) }}</td><td style="{{ tdr }};color:#555">
      {%- if r.fx.change is none %}—{% elif r.fx.change > 0 %}台幣貶 {{ "{:.3f}".format(r.fx.change) }}{% elif r.fx.change < 0 %}台幣升 {{ "{:.3f}".format(-r.fx.change) }}{% else %}持平{% endif -%}
    </td></tr>
    {% endif %}
    {% if r.pcr %}
    <tr><td style="{{ td }}">P/C Ratio（未平倉）</td><td style="{{ tdr }}">{{ "{:.2f}".format(r.pcr.oi_ratio) }}%</td><td style="{{ tdr }}"></td></tr>
    <tr><td style="{{ td }}">P/C Ratio（成交量）</td><td style="{{ tdr }}">{{ "{:.2f}".format(r.pcr.volume_ratio) }}%</td><td style="{{ tdr }}"></td></tr>
    {% endif %}
    {% if r.margin %}
    <tr><td style="{{ td }}">融資餘額</td><td style="{{ tdr }}">{{ "{:,.2f}".format(r.margin.margin_balance_billion) }} 億</td><td style="{{ tdr }}">{{ signed(r.margin.margin_change_billion) }} 億</td></tr>
    <tr><td style="{{ td }}">融券餘額</td><td style="{{ tdr }}">{{ "{:,}".format(r.margin.short_balance) }} 張</td><td style="{{ tdr }}">{{ signed(r.margin.short_change, "{:,}") }} 張</td></tr>
    {% endif %}
  </table>
  {% endif %}

  {% if r.news %}
  <h2 style="{{ h2 }}">近期新聞整理</h2>
  {% for g in r.news %}
  <div style="font-size:13px;font-weight:600;color:#555;margin:14px 0 4px">{{ g.name }}</div>
  <table style="width:100%;border-collapse:collapse">
    {% for n in g.items %}
    <tr>
      <td style="{{ td }};width:74px;vertical-align:top;color:#888;font-size:12px;white-space:nowrap">{{ n.published.strftime('%m/%d %H:%M') }}</td>
      <td style="{{ td }};line-height:1.5">
        <a href="{{ n.url }}" style="color:#1c1e21;text-decoration:none">{{ n.title }}</a>
        {% if n.tags %}<div style="font-size:12px;color:#888;margin-top:2px">{% for t in n.tags %}#{{ t }}{% if not loop.last %}　{% endif %}{% endfor %}</div>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
  {% endfor %}
  <div style="font-size:12px;color:#999;margin-top:6px">依關鍵字自動挑選，點標題可閱讀全文（鉅亨網）。</div>
  {% endif %}

  {% if r.warnings %}
  <div style="margin-top:24px;padding:12px;background:#fff8e6;border-radius:8px;font-size:13px;color:#8a6100">
    以下資料未能取得：<br>{% for w in r.warnings %}・{{ w }}<br>{% endfor %}
  </div>
  {% endif %}

  <div style="margin-top:28px;font-size:12px;color:#999;line-height:1.6">
    資料來源：臺灣證券交易所、臺灣期貨交易所、臺灣銀行牌告匯率、鉅亨網。本報告由程式自動產生，僅供參考。
  </div>
</div>
</div>
</body>
</html>
